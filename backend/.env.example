# Copiar a .env (no se sube a GitHub)
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=app_partituras
PORT=3000
# Usuario con el que actúa la API (no hay pantalla de login en esta etapa)
DEMO_USER_EMAIL=camila.rojas@example.com
# Habilita /api/admin/estructura (ALTER/DROP equivalentes). Dejar en false salvo en la demo.
ENABLE_ADMIN=false
CORS_ORIGIN=*
