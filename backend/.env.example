# Copiar a .env (no se sube a GitHub). En Render, estas mismas variables van en Environment.

# ── Servidor ─────────────────────────────────────────────
PORT=3000
# Origen permitido del front (en producción, la URL del Static Site de Render; sin "/" al final)
CORS_ORIGIN=http://localhost:5173

# ── MongoDB Atlas (BD NoSQL: partituras, obras, catálogos, ratings, biblioteca) ──
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=app_partituras

# ── TiDB Cloud (BD relacional: usuarios) ─────────────────
# Datos del botón "Connect" del clúster (us-east-1). TiDB Starter exige TLS.
# Para "npm run db:init" usar el usuario root; para la app, el usuario creado con db/usuario_app.sql
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=PREFIJO.app_partituras
DB_PASSWORD=CAMBIAR
DB_NAME=app_partituras
DB_SSL=true
# Máximo de conexiones simultáneas del pool
DB_POOL_SIZE=5

# ── Autenticación JWT ────────────────────────────────────
# Secreto largo y aleatorio: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_este_secreto
JWT_EXPIRES_IN=24h

# ── Otros ────────────────────────────────────────────────
# Usuario protegido contra eliminación (DELETE /usuarios/:id)
DEMO_USER_EMAIL=camila.rojas@example.com
# Habilita /api/admin/estructura (ALTER/DROP). Dejar en false salvo en la demo.
ENABLE_ADMIN=false
